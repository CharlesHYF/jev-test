{
  "name": "jev-openai-chat-inspector",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && node scripts/copy-static.mjs",
